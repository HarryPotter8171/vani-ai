# =============================================================================
# VANI AI backend — environment variables
# =============================================================================
# Copy to `.env` for local development.
# In production, inject these as real environment / secret-manager values
# (Docker Compose `env_file`, Kubernetes secrets, Cloud Run env, etc.).
# Do NOT commit a populated `.env` file.
#
# Validation: `backend/config/validateEnv.js` refuses to start when
# NODE_ENV=production and a required variable is missing.
# See LAUNCH_CHECKLIST.md for the launch-day checklist.
# =============================================================================

# --- Core (required) ---------------------------------------------------------
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/vani-ai

# --- Auth (required in production) -------------------------------------------
# AUTH_JWT_SECRET signs/verifies backend access tokens.
# NEXTAUTH_SECRET must match the frontend's NextAuth secret.
# Production requires BOTH, each ≥32 characters, and they MUST be distinct
# (do not reuse one value for both — validateEnv refuses boot otherwise).
AUTH_JWT_SECRET=
NEXTAUTH_SECRET=

# --- CORS --------------------------------------------------------------------
# Frontend origin(s) allowed to call this API with credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated extra origins (staging, preview deploys, …).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# APP_URL is an alias for NEXT_PUBLIC_APP_URL if the latter is unset.
# APP_URL=

# --- Gemini / Vertex AI (required in production) -----------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Prefer Vertex AI routing when using GCP (client libraries may honor this).
GOOGLE_GENAI_USE_VERTEXAI=true
# Optional — omit on GCP infra with attached workload identity / service account.
# When set, the path must be a readable service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json

# --- Memory encryption (required in production) ------------------------------
# 32-byte hex, or any passphrase (hashed to a key). Encrypts memory at rest.
# Changing this key makes previously encrypted memories unreadable.
VANI_MEMORY_ENCRYPTION_KEY=

# --- Web search / research (optional) ----------------------------------------
# Set TAVILY_ENABLED=true to require TAVILY_API_KEY; otherwise falls back to
# Gemini Google Search grounding / DuckDuckGo automatically.
TAVILY_ENABLED=false
TAVILY_API_KEY=

# --- Redis (optional single-instance; required for Public Beta / multi-replica)
# Leave unset for a single-instance local deploy (in-process limiter fallback).
# Set either REDIS_URL or REDIS_HOST.
#
# Required when:
#   - REQUIRE_REDIS=true (docker-compose production-shaped stack sets this), OR
#   - NODE_ENV=production AND (VANI_REPLICAS|WEB_CONCURRENCY|INSTANCE_COUNT) > 1
# Public Beta: set REQUIRE_REDIS=true.
# REQUIRE_REDIS=true
# VANI_REPLICAS=1
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_TLS=false

# --- Observability (optional) ------------------------------------------------
# Log level: debug | info | warn | error (also: fatal, silent, trace).
LOG_LEVEL=info
# Sentry — leave empty to use structured logs only (still production-safe).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Optional release tag shown on /version and attached to Sentry events.
SENTRY_RELEASE=

# --- Production Analytics / Platform Admin -----------------------------------
# Comma-separated emails promoted to platform admin on auth sync.
# Required for /api/analytics/admin/* (distinct from Business plan org admin).
# VANI_ADMIN_EMAILS=you@example.com,ops@example.com
# Sample rate for successful API request event persistence (0–1). Errors always logged.
# VANI_ANALYTICS_SAMPLE_RATE=0.25
# VANI_ANALYTICS_TTL_DAYS=90
# VANI_ANALYTICS_ACTIVE_DAYS=30
# Cost estimates used for admin profit (USD):
# VANI_ANALYTICS_TOKEN_COST_PER_M=2.5
# VANI_ANALYTICS_IMAGE_COST=0.04
# VANI_ANALYTICS_VOICE_COST_PER_MIN=0.006

# --- Proxy / TLS -------------------------------------------------------------
# Trust X-Forwarded-* from a reverse proxy. Defaults to on in production.
# Set TRUST_PROXY=false to disable, or a hop count (e.g. 1, 2).
TRUST_PROXY=
# Append "; preload" to HSTS when true (only after you intend to preload).
HSTS_PRELOAD=false

# --- Rate limits (optional overrides; sane defaults otherwise) ---------------
VANI_AUTH_RATE_LIMIT_WINDOW_MS=60000
VANI_AUTH_RATE_LIMIT_MAX=20
VANI_CHAT_RATE_LIMIT_WINDOW_MS=60000
VANI_CHAT_RATE_LIMIT_MAX=60
VANI_CHAT_PUBLIC_RATE_LIMIT_WINDOW_MS=60000
VANI_CHAT_PUBLIC_RATE_LIMIT_MAX=30
VANI_PROJECTS_RATE_LIMIT_WINDOW_MS=60000
VANI_PROJECTS_RATE_LIMIT_MAX=120

# --- Health thresholds (informational only; do not gate /ready) --------------
VANI_DISK_WARN_PCT=90
VANI_MEMORY_WARN_PCT=95

# --- Feature flags (optional) ------------------------------------------------
VANI_ENABLE_BROWSER_AUTOMATION=false
VANI_ENABLE_CODE_EXECUTION=false
VANI_DISABLE_IMAGE_GEN=false
# FEATURE_GATING_DISABLED=true   # emergency local bypass ONLY — production boot refuses if set
# MCP_ALLOW_STDIO=true           # local/dev only: allow spawning MCP via stdio (never in production)
# After enabling browser automation, install Chromium once:
#   cd backend && npm run install:browsers
# (also runs on full local `npm install` postinstall; skipped for production /
#  `npm ci --omit=dev` / PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1)

# --- Free plan quota overrides (UsageGuard / PlanService seed) ---------------
# VANI_PLAN_FREE_CHAT_REQUESTS=100
# VANI_PLAN_FREE_IMAGE_GENERATION=20
# VANI_PLAN_FREE_VOICE_MINUTES=10
# VANI_PLAN_FREE_RESEARCH_RUNS=5
# VANI_PLAN_FREE_BROWSER_SESSIONS=0
# VANI_PLAN_FREE_CODE_EXECUTIONS=0
# VANI_PLAN_FREE_TOKENS=500000
# VANI_PLAN_FREE_FILE_STORAGE_BYTES=104857600
# VANI_PRIORITY_MODEL=gemini/gemini-2.5-pro

# --- Stripe billing (optional — local plan changes work without these) --------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...
# Success/cancel URLs default to NEXT_PUBLIC_APP_URL / APP_URL.

# --- Razorpay billing (optional — UPI / Cards / Net Banking) ------------------
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# RAZORPAY_PLAN_PRO_MONTHLY=plan_...
# RAZORPAY_PLAN_PRO_YEARLY=plan_...
# RAZORPAY_PLAN_BUSINESS_MONTHLY=plan_...
# RAZORPAY_PLAN_BUSINESS_YEARLY=plan_...
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
# When both Stripe and Razorpay are configured:
# BILLING_DEFAULT_PROVIDER=razorpay
# Webhook URL: https://<api-host>/api/billing/webhooks/razorpay

# --- Code Interpreter (optional — requires Python 3 + sandbox packages) ------
# VANI_CODE_INTERPRETER_PYTHON=python3
# VANI_CODE_INTERPRETER_DIR=./.code-interpreter
# VANI_CI_CPU_SECONDS=30
# VANI_CI_MEMORY_MB=512
# VANI_CI_DISK_MB=256
# VANI_CI_TIMEOUT_MS=30000
# VANI_CI_MAX_SESSIONS_PER_USER=3
# VANI_CI_MAX_CODE_CHARS=100000
# VANI_CI_IDLE_TTL_MS=900000
# VANI_CI_DISABLE_UNSHARE=false
# CODE_INTERPRETER_DEBUG=false

# --- Model / AI tuning (optional) --------------------------------------------
# VANI_CHAT_MODEL=
# VANI_IMAGE_MODEL=gemini-2.5-flash-image
# Image edits use the same Gemini image model via generateContent + source
# inlineData (never text-to-image, never deprecated Imagen editImage).
# VANI_IMAGE_EDIT_MAX_EDGE=1568
# VANI_EMBEDDING_MODEL=
# VANI_STT_MODEL=
# VANI_TTS_MODEL=
# VANI_TTS_MAX_CHARS=
# Message read-aloud (Listen button) — ElevenLabs Flash v2.5 streaming MP3.
# Put the real key ONLY in backend/.env (gitignored). Never add it to the
# frontend, NEXT_PUBLIC_*, or client bundles. Frontend calls POST /api/tts only.
ELEVENLABS_API_KEY=
# Voice: Jessica (default, premium female). Lily: pFZP5JQG7iQjIQuC4Bku
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_TTS_MAX_CHARS=5000

# VANI_STT_MAX_BYTES=
# VANI_VOICE_SESSION_TTL_MS=
# Duplex voice WebSocket is always on at /api/voice/ws (JWT via ?token=).
# Voice engine (Phase 1 Live Native Audio — backend only; frontend stays legacy):
#   VOICE_ENGINE=legacy  → STT → chat SSE → TTS (default, production-safe)
#   VOICE_ENGINE=live    → Gemini Live bidirectional PCM via ai.live.connect()
# Live uses a dedicated Vertex client with apiVersion=v1beta1 (chat stays on v1).
# VOICE_ENGINE=legacy
# VANI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
# VANI_LIVE_INPUT_RATE=16000
# VANI_LIVE_OUTPUT_RATE=24000
# VANI_LIVE_MAX_SESSIONS_PER_USER=2
# VANI_LIVE_IDLE_TIMEOUT_MS=300000
# When true, unset/auto model selections use intent-based routing.
# VANI_AUTO_ROUTE=false

# --- Alternate model providers (optional — Gemini remains the default) -------
# OPENAI_API_KEY=
# IMAGE_PROVIDER=gemini   # gemini | openai (image_edit only; image_generation remains Gemini)
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=

# --- Memory / RAG tuning (optional) ------------------------------------------
# VANI_MEMORY_MAX=
# VANI_MEMORY_TOP_K=
# VANI_MEMORY_MIN_SCORE=
# VANI_MEMORY_CACHE_TTL_MS=
# VANI_MEMORY_DUP_SIM=
# VANI_MEMORY_CLEANUP_MIN=
# VANI_MEMORY_CLEANUP_DAYS=
# VANI_MEMORY_CLEANUP_INTERVAL_MS=
# VANI_RAG_CANDIDATE_LIMIT=

# --- Document / vision / OCR / voice / browser (optional) --------------------
# VANI_PDF_SCAN_MIN_CHARS=
# VANI_PDF_SCAN_MIN_CHARS_PER_PAGE=
# VANI_PDF_OCR_MAX_PAGES=
# VANI_PDF_OCR_SCALE=
# VANI_DOC_MAX_CHARS=
# --- PDF Intelligence (optional) ---------------------------------------------
# VANI_PDF_INTEL_MAX_PAGES=500
# VANI_PDF_INTEL_WARN_PAGES=200
# VANI_PDF_INTEL_PAGE_MAX_CHARS=8000
# VANI_PDF_INTEL_QA_CONTEXT_CHARS=24000
# VANI_PDF_INTEL_TOP_K=8
# VANI_PDF_INTEL_MIN_SCORE=0.12
# VANI_PDF_INTEL_CHUNK_CHARS=1800
# VANI_PDF_INTEL_CHUNK_OVERLAP=200
# VANI_PDF_INTEL_CONV_TURNS=12
# VANI_PDF_INTEL_MODEL=
# VANI_VISION_MAX_EDGE=
# VANI_VISION_JPEG_QUALITY=
# VANI_OCR_MAX_EDGE=
# VANI_OCR_MAX_CHARS=
# Tesseract worker pool size (1–4, default 2).
# OCR_WORKER_POOL_SIZE=2
# Default eng+hin (vendored via @tesseract.js-data/eng + @tesseract.js-data/hin).
# VANI_OCR_LANG=eng+hin
# VANI_OCR_PDF_MAX_PAGES=
# VANI_OCR_PDF_SCALE=
# VANI_BROWSER_APPROVAL_TIMEOUT_MS=
# VANI_BROWSER_STORAGE_DIR=
# BROWSER_DEBUG=false
# MCP_DEBUG=false
